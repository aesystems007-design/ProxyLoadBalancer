{
  // Dashboard: /_proxy/dashboard/
  // Proxy:ConfigStore selects Sqlite (default) or SqlServer.
  // Sqlite copies this ReverseProxy section into App_Data/proxy.db on first start.
  // SqlServer reads ConnectionStrings:Proxy and stays a stub until SqlServerProxyConfigStore is implemented.
  // After startup, the selected store is the configuration the proxy loads and reloads.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Proxy": {
    "ExposeStatus": true,
    "LogChosenDestination": false,
    "ConfigStore": "Sqlite"
  },
  "ReverseProxy": {
    "Routes": {
      "app": {
        "ClusterId": "app",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "app": {
        "LoadBalancingPolicy": "RoundRobin",
        "SessionAffinity": {
          "Enabled": false,
          "Policy": "HashCookie",
          "FailurePolicy": "Redistribute",
          "AffinityKeyName": "Yarp.Affinity"
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyOrPanic",
          "Active": {
            "Enabled": false,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2",
          "TransportFailureRateHealthPolicy.RateLimit": "0.5"
        },
        "HttpClient": {
          "EnableMultipleHttp2Connections": true
        },
        "HttpRequest": {
          "ActivityTimeout": "00:02:00",
          "Version": "2.0",
          "VersionPolicy": "RequestVersionOrLower"
        },
        "Destinations": {
          "iis-1": {
            "Address": "http://localhost:8081/"
          },
          "iis-2": {
            "Address": "http://localhost:8082/"
          }
          // Add another server as another destination, for example:
          // "iis-other-server": {
          //   "Address": "http://appserver02.example.com/"
          // }
        }
      }
    }
  }
}
